#!/usr/bin/env python3
import subprocess
import sys
import os

# Disable X11 in the entire environment
os.environ["GMX_NO_X11"] = "1"
os.environ["DISPLAY"] = ""

def run_command(command, description):
    print(f"\n{description}")
    print(f"Running: {command}")
    env = os.environ.copy()
    try:
        subprocess.run(command, shell=True, check=True, env=env)
    except subprocess.CalledProcessError as e:
        print("Error while executing the command.")
        sys.exit(1)

def main():
    if len(sys.argv) != 2 or not sys.argv[1].endswith(".pdb"):
        print("Usage: ./md_sim.py file.pdb")
        sys.exit(1)

    pdb_file = sys.argv[1]
    base_name = os.path.splitext(pdb_file)[0]

    # Step 1: pdb2gmx (interactive)
    print("\nStep 1: Manually select the force field and water model when prompted.")
    cmd1 = f"gmx_mpi pdb2gmx -f {pdb_file} -o {base_name}.gro"
    run_command(cmd1, "Generating topology with pdb2gmx")

    # Step 2: editconf
    cmd2 = f"gmx_mpi editconf -f {base_name}.gro -o box.gro -c -d 2.0 -bt cubic"
    run_command(cmd2, "Step 2: Defining box with editconf")

    # Step 3: solvate
    cmd3 = f"gmx_mpi solvate -cp box.gro -cs spc216.gro -o solv.gro -p topol.top"
    run_command(cmd3, "Step 3: Solvating with spc216")

    # Step 4: grompp for ions
    cmd4 = f"gmx_mpi grompp -f ../MDPs/ions.mdp -c solv.gro -p topol.top -o ions.tpr"
    run_command(cmd4, "Step 4: Preparing system for ion insertion")

    # Step 5: genion (interactive)
    print("\nStep 5: Manually select the 'SOL' group when prompted.")
    cmd5 = f"gmx_mpi genion -s ions.tpr -o ions.gro -p topol.top -pname NA -nname CL -neutral"
    run_command(cmd5, "Inserting ions with genion")

    # Step 6: grompp for minimization
    cmd6 = f"gmx_mpi grompp -f ../MDPs/minim.mdp -c ions.gro -p topol.top -o em.tpr"
    run_command(cmd6, "Step 6: Preparing energy minimization")

    # Step 7: mdrun minimization
    cmd7 = f"gmx_mpi mdrun -v -deffnm em"
    run_command(cmd7, "Step 7: Running energy minimization")

    # Step 8: grompp for NVT
    cmd8 = f"gmx_mpi grompp -f ../MDPs/nvt.mdp -c em.gro -r em.gro -p topol.top -o nvt.tpr"
    run_command(cmd8, "Step 8: Preparing NVT simulation")

    # Step 9: mdrun NVT
    cmd9 = f"gmx_mpi mdrun -deffnm nvt -v -nb gpu -bonded gpu -pme gpu -pin on -update gpu"
    run_command(cmd9, "Step 9: Running NVT simulation")

    # Step 10: grompp for NPT
    cmd10 = f"gmx_mpi grompp -f ../MDPs/npt.mdp -c nvt.gro -r nvt.gro -t nvt.cpt -p topol.top -o npt.tpr"
    run_command(cmd10, "Step 10: Preparing NPT simulation")

    # Step 11: mdrun NPT
    cmd11 = f"gmx_mpi mdrun -deffnm npt -v -nb gpu -bonded gpu -pme gpu -pin on -update gpu"
    run_command(cmd11, "Step 11: Running NPT simulation")

    # Step 12: grompp for production MD
    cmd12 = f"gmx_mpi grompp -f ../MDPs/md.mdp -c npt.gro -t npt.cpt -p topol.top -o md.tpr"
    run_command(cmd12, "Step 12: Preparing production MD simulation")

    # Step 13: mdrun production MD
    cmd13 = f"gmx_mpi mdrun -deffnm md -v -nb gpu -bonded gpu -pme gpu -pin auto -update gpu"
    run_command(cmd13, "Step 13: Running production MD simulation")

    print("\nSimulation successfully completed. Final files: md.xtc, md.gro, md.log")

if __name__ == "__main__":
    main()
